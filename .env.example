# Climate Trend Analyzer - Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

# Data source URLs (Defaults to NASA GISTEMP public datasets)
NASA_GISTEMP_GLOBAL_URL=https://data.giss.nasa.gov/gistemp/graphs/graph_data/Global_Mean_Estimates_based_on_Land_and_Ocean_Data/graph.txt

# Execution Settings
LOG_LEVEL=INFO
RANDOM_SEED=42

# Output Paths (relative to project root or absolute paths within project root)
PROJECT_OUTPUT_DIR=outputs
PROJECT_DATA_DIR=data

